diff --git a/rtabmap_util/CMakeLists.txt b/rtabmap_util/CMakeLists.txt
index 9c287b4a..c080abd0 100644
--- a/rtabmap_util/CMakeLists.txt
+++ b/rtabmap_util/CMakeLists.txt
@@ -1,6 +1,12 @@
 cmake_minimum_required(VERSION 3.5)
 project(rtabmap_util)
 
+if(WIN32)
+  # Windows.h defines min/max macros that break Eigen's std::min/std::max
+  # expressions when compiling the RTAB-Map utility sources with MSVC.
+  add_definitions(-DNOMINMAX)
+endif()
+
 if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
   add_compile_options(-Wall -Wextra -Wpedantic)
 endif()
@@ -149,6 +155,13 @@ add_library(rtabmap_util SHARED
 add_library(rtabmap_util_plugins SHARED
    ${rtabmap_util_plugins_src}
 )
+if(WIN32)
+  # MapsManager is consumed by the plugin DLL, but this upstream target does
+  # not annotate its public symbols on Windows.  Generate its import library;
+  # keep the large plugin DLL on its explicit component exports.
+  set_target_properties(rtabmap_util PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
+  target_compile_definitions(rtabmap_util_plugins PRIVATE RTABMAP_UTIL_BUILDING_DLL)
+endif()
 target_include_directories(rtabmap_util
   PUBLIC
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
