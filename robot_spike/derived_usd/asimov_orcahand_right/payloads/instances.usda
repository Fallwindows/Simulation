    def Xform "right_visual_tower_main_mesh" (
        prepend references = @./geometries.usd@</Geometries/right_visual_tower_main_mesh>
    )
    {
        over "right_visual_tower_main_mesh" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/right_visual_tower_main_mesh/VisualMaterials/white>
            custom string urdf:name = "right_visual_tower_main_mesh"
        }

        def Scope "VisualMaterials"
        {
            def Material "white" (
