                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55000, 0.68000, 0.58000)
                float inputs:roughness = 0.1600
                float inputs:metallic = 0.0000
                float inputs:opacity = 0.7200
                token outputs:surface
            }
        }
        def Material "Paper" {
            token outputs:surface.connect = </Asset/Looks/Paper/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82000, 0.79000, 0.69000)
                float inputs:roughness = 0.7800
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Clear" {
            token outputs:surface.connect = </Asset/Looks/Clear/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74000, 0.86000, 0.91000)
                float inputs:roughness = 0.1200
                float inputs:metallic = 0.0000
                float inputs:opacity = 0.3800
                token outputs:surface
            }
        }
        def Material "Dark" {
            token outputs:surface.connect = </Asset/Looks/Dark/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05500, 0.06500, 0.07500)
                float inputs:roughness = 0.3800
                float inputs:metallic = 0.0500
                token outputs:surface
            }
        }
        def Material "Accent" {
            token outputs:surface.connect = </Asset/Looks/Accent/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.30980, 0.47451, 0.65882)
                float inputs:roughness = 0.6600
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Print" {
            token outputs:surface.connect = </Asset/Looks/Print/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/bread_loaf.png@
                float2 inputs:st.connect = </Asset/Looks/Print/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "NormalTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/bread_loaf_normal.png@
                float2 inputs:st.connect = </Asset/Looks/Print/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "RoughnessTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/bread_loaf_roughness.png@
                float2 inputs:st.connect = </Asset/Looks/Print/StReader.outputs:result>
                float outputs:r
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.30980, 0.47451, 0.65882)
                float inputs:roughness = 0.6600
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Print/Texture.outputs:rgb>
                normal3f inputs:normal.connect = </Asset/Looks/Print/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </Asset/Looks/Print/RoughnessTexture.outputs:r>
                token outputs:surface
            }
        }
    }
}
