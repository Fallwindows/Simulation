                float inputs:roughness = 0.7200
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                normal3f inputs:normal.connect = </Asset/Looks/Front/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </Asset/Looks/Front/RoughnessTexture.outputs:r>
