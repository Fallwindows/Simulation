#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Xform "PackageBelly" {
            double3 xformOp:translate = (0.00000, 0.00000, -0.00255)
            double3 xformOp:scale = (0.15500, 0.07000, 0.22440)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Sphere "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double radius = 0.5
                rel material:binding = </Asset/Looks/Body>
            }
        }
        def Xform "PackageTopSeal" {
            double3 xformOp:translate = (0.00000, 0.00000, 0.11794)
            double3 xformOp:scale = (0.06820, 0.01225, 0.00701)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "PackageBottomGusset" {
            double3 xformOp:translate = (0.00000, 0.00000, -0.11985)
            double3 xformOp:scale = (0.06355, 0.02520, 0.00765)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "PackageLeftSeam" {
            double3 xformOp:translate = (-0.07208, 0.00000, 0.00000)
            double3 xformOp:scale = (0.00271, 0.01050, 0.09180)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "PackageRightSeam" {
            double3 xformOp:translate = (0.07208, 0.00000, 0.00000)
            double3 xformOp:scale = (0.00271, 0.01050, 0.09180)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "Crimp-1" {
            double3 xformOp:translate = (0.00000, 0.00000, -0.12112)
            double3 xformOp:scale = (0.07130, 0.00980, 0.00574)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Metal>
            }
        }
        def Xform "Crimp1" {
            double3 xformOp:translate = (0.00000, 0.00000, 0.12112)
            double3 xformOp:scale = (0.07130, 0.00980, 0.00574)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Metal>
            }
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.06138, 0.03700, -0.06640), (0.06138, 0.03700, -0.06640), (0.06138, 0.03700, 0.06640), (-0.06138, 0.03700, 0.06640)]
            int[] faceVertexCounts = [4]
            # Winding and the authored +Y normal must agree; viewed from the
            # local front (+Y), this order faces outward and preserves upright UVs.
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, 1, 0)] (
                interpolation = "uniform"
            )
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72941, 0.24314, 0.19608)
                float inputs:roughness = 0.6200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/chips_bag.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.91765, 0.76863, 0.26667)
                float inputs:roughness = 0.5400
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                token outputs:surface
            }
        }
        def Material "Metal" {
            token outputs:surface.connect = </Asset/Looks/Metal/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48000, 0.52000, 0.55000)
                float inputs:roughness = 0.2800
                float inputs:metallic = 0.7000
                token outputs:surface
            }
        }
        def Material "Stem" {
            token outputs:surface.connect = </Asset/Looks/Stem/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12000, 0.23000, 0.08000)
                float inputs:roughness = 0.7200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Glass" {
            token outputs:surface.connect = </Asset/Looks/Glass/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55000, 0.68000, 0.58000)
                float inputs:roughness = 0.1600
                float inputs:metallic = 0.0000
                float inputs:opacity = 0.7200
                token outputs:surface
            }
        }
        def Material "Paper" {
            token outputs:surface.connect = </Asset/Looks/Paper/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82000, 0.79000, 0.69000)
                float inputs:roughness = 0.7800
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Clear" {
            token outputs:surface.connect = </Asset/Looks/Clear/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74000, 0.86000, 0.91000)
                float inputs:roughness = 0.1200
                float inputs:metallic = 0.0000
                float inputs:opacity = 0.3800
                token outputs:surface
            }
        }
        def Material "Dark" {
            token outputs:surface.connect = </Asset/Looks/Dark/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05500, 0.06500, 0.07500)
                float inputs:roughness = 0.3800
                float inputs:metallic = 0.0500
                token outputs:surface
            }
        }
    }
}
