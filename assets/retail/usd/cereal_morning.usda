#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Mesh "BodyShell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.05750, -0.05000, -0.15000), (0.05750, -0.05000, -0.15000), (0.06500, -0.04250, -0.15000), (0.06500, 0.04250, -0.15000), (0.05750, 0.05000, -0.15000), (-0.05750, 0.05000, -0.15000), (-0.06500, 0.04250, -0.15000), (-0.06500, -0.04250, -0.15000), (-0.05750, -0.05000, 0.15000), (0.05750, -0.05000, 0.15000), (0.06500, -0.04250, 0.15000), (0.06500, 0.04250, 0.15000), (0.05750, 0.05000, 0.15000), (-0.05750, 0.05000, 0.15000), (-0.06500, 0.04250, 0.15000), (-0.06500, -0.04250, 0.15000)]
