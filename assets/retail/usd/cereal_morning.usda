        ) {
            point3f[] points = [(-0.06600, -0.04400, -0.12600), (-0.06600, 0.04400, -0.12600), (-0.06600, 0.04400, 0.12600), (-0.06600, -0.04400, 0.12600)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(-1, 0, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.000000, 0.040000), (0.217391, 0.040000), (0.217391, 0.960000), (0.000000, 0.960000)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Front>
        }
        def Mesh "HeroRightPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(0.06600, 0.04400, -0.12600), (0.06600, -0.04400, -0.12600), (0.06600, -0.04400, 0.12600), (0.06600, 0.04400, 0.12600)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(1, 0, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.500000, 0.040000), (0.717391, 0.040000), (0.717391, 0.960000), (0.500000, 0.960000)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Front>
        }
        def Mesh "HeroBackPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.05720, -0.05100, -0.12600), (0.05720, -0.05100, -0.12600), (0.05720, -0.05100, 0.12600), (-0.05720, -0.05100, 0.12600)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, -1, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.717391, 0.040000), (1.000000, 0.040000), (1.000000, 0.960000), (0.717391, 0.960000)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Front>
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22353, 0.55686, 0.61961)
                float inputs:roughness = 0.7400
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/cereal_morning.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "NormalTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/cereal_morning_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "RoughnessTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/cereal_morning_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float outputs:r
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93725, 0.88235, 0.66275)
                float inputs:roughness = 0.6400
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                normal3f inputs:normal.connect = </Asset/Looks/Front/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </Asset/Looks/Front/RoughnessTexture.outputs:r>
                token outputs:surface
            }
        }
        def Material "Metal" {
            token outputs:surface.connect = </Asset/Looks/Metal/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48000, 0.52000, 0.55000)
                float inputs:roughness = 0.2800
                float inputs:metallic = 0.7000
                token outputs:surface
            }
        }
        def Material "Stem" {
            token outputs:surface.connect = </Asset/Looks/Stem/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12000, 0.23000, 0.08000)
                float inputs:roughness = 0.7200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
    }
}
