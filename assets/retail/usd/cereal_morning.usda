            int[] faceVertexIndices = [7, 6, 5, 4, 3, 2, 1, 0, 8, 9, 10, 11, 12, 13, 14, 15, 0, 1, 9, 8, 1, 2, 10, 9, 2, 3, 11, 10, 3, 4, 12, 11, 4, 5, 13, 12, 5, 6, 14, 13, 6, 7, 15, 14, 7, 0, 8, 15]
            rel material:binding = </Asset/Looks/Body>
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.05720, 0.05200, -0.12600), (0.05720, 0.05200, -0.12600), (0.05720, 0.05200, 0.12600), (-0.05720, 0.05200, 0.12600)]
            int[] faceVertexCounts = [4]
            # Winding and the authored +Y normal must agree; viewed from the
            # local front (+Y), this order faces outward and preserves upright UVs.
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, 1, 0)] (
                interpolation = "uniform"
            )
            texCoord2f[] primvars:st = [(0.217391, 0.040000), (0.500000, 0.040000), (0.500000, 0.960000), (0.217391, 0.960000)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
        def Xform "TopBand" {
            double3 xformOp:translate = (0.00000, 0.05800, 0.10200)
            double3 xformOp:scale = (0.05590, 0.00600, 0.01500)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "BottomTrim" {
            double3 xformOp:translate = (0.00000, 0.05900, -0.12000)
            double3 xformOp:scale = (0.05330, 0.00500, 0.00375)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Metal>
            }
        }
        def Mesh "HeroLeftPrintPanel" (
