            double height = 0.00336
            double3 xformOp:translate = (0, 0, 0.08400)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Accent>
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.05487, 0.07450, -0.07291), (0.05487, 0.07450, -0.07291), (0.05487, 0.07450, 0.07291), (-0.05487, 0.07450, 0.07291)]
            int[] faceVertexCounts = [4]
            # Winding and the authored +Y normal must agree; viewed from the
            # local front (+Y), this order faces outward and preserves upright UVs.
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, 1, 0)] (
                interpolation = "uniform"
            )
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
        def Mesh "LeftPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.07350, -0.05220, -0.07560), (-0.07350, 0.05220, -0.07560), (-0.07350, 0.05220, 0.07560), (-0.07350, -0.05220, 0.07560)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
