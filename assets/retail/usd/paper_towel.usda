#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Cylinder "PaperCylinder" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.07250
            double height = 0.28000
