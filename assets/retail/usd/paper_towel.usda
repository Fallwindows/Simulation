            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.07395
            double height = 0.00336
            double3 xformOp:translate = (0, 0, -0.08400)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Accent>
        }
