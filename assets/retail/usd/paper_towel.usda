                float3 outputs:rgb
            }
            def Shader "RoughnessTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/paper_towel_roughness.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float outputs:r
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.26667, 0.52941, 0.67059)
                float inputs:roughness = 0.4200
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                normal3f inputs:normal.connect = </Asset/Looks/Front/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </Asset/Looks/Front/RoughnessTexture.outputs:r>
                token outputs:surface
            }
        }
        def Material "Metal" {
