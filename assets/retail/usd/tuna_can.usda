#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Cylinder "CanBody" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.04560
            double height = 0.04500
            rel material:binding = </Asset/Looks/Body>
        }
        def Cylinder "TopRim" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.04750
            double height = 0.00360
            double3 xformOp:translate = (0, 0, 0.02070)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Metal>
        }
        def Cylinder "BottomRim" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.04750
            double height = 0.00270
            double3 xformOp:translate = (0, 0, -0.02115)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Metal>
        }
        def Xform "PullTab" {
            double3 xformOp:translate = (0.00950, 0.00000, 0.02070)
            double3 xformOp:scale = (0.02660, 0.01140, 0.00270)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Sphere "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double radius = 0.5
                rel material:binding = </Asset/Looks/Dark>
            }
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.03678, 0.04950, -0.01247), (0.03678, 0.04950, -0.01247), (0.03678, 0.04950, 0.01247), (-0.03678, 0.04950, 0.01247)]
            int[] faceVertexCounts = [4]
            # Winding and the authored +Y normal must agree; viewed from the
            # local front (+Y), this order faces outward and preserves upright UVs.
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, 1, 0)] (
                interpolation = "uniform"
            )
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
        def Mesh "LeftPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.04850, -0.03420, -0.01215), (-0.04850, 0.03420, -0.01215), (-0.04850, 0.03420, 0.01215), (-0.04850, -0.03420, 0.01215)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(-1, 0, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.05, 0.12), (0.34, 0.12), (0.34, 0.88), (0.05, 0.88)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Print>
        }
        def Mesh "RightPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(0.04850, 0.03420, -0.01215), (0.04850, -0.03420, -0.01215), (0.04850, -0.03420, 0.01215), (0.04850, 0.03420, 0.01215)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(1, 0, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.05, 0.12), (0.34, 0.12), (0.34, 0.88), (0.05, 0.88)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Print>
        }
        def Mesh "BackPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.03610, -0.04850, -0.01710), (0.03610, -0.04850, -0.01710), (0.03610, -0.04850, -0.00990), (-0.03610, -0.04850, -0.00990)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, -1, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.08, 0.08), (0.92, 0.08), (0.92, 0.34), (0.08, 0.34)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Print>
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.30196, 0.48627, 0.65098)
                float inputs:roughness = 0.3600
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/tuna_can.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "NormalTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/tuna_can_normal.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "RoughnessTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/tuna_can_roughness.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float outputs:r
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88235, 0.77255, 0.30196)
                float inputs:roughness = 0.4800
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                normal3f inputs:normal.connect = </Asset/Looks/Front/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </Asset/Looks/Front/RoughnessTexture.outputs:r>
                token outputs:surface
            }
        }
        def Material "Metal" {
