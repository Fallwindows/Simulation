#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Cylinder "Body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 40
            double radius = 0.04550
            double height = 0.17920
            double3 xformOp:translate = (0, 0, -0.03360)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Body>
        }
        def Cone "Shoulder" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 40
            double radius = 0.04550
            double radius2 = 0.02850
            double height = 0.02660
            double3 xformOp:translate = (0, 0, 0.06860)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Body>
        }
        def Cylinder "Neck" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 32
            double radius = 0.02850
            double height = 0.04760
            double3 xformOp:translate = (0, 0, 0.10080)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Body>
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.04400, 0.05200, -0.04939), (0.04400, 0.05200, -0.04939), (0.04400, 0.05200, 0.04939), (-0.04400, 0.05200, 0.04939)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(0, 1, 0)]
            uniform token[] normals:interpolation = ["uniform"]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
        def Cylinder "Cap" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 32
            double radius = 0.03000
            double height = 0.01540
            double3 xformOp:translate = (0, 0, 0.13720)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Metal>
        }
        def Cylinder "CapRidge" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 32
            double radius = 0.03150
            double height = 0.00392
            double3 xformOp:translate = (0, 0, 0.12880)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Metal>
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.27843, 0.68235, 0.61569)
                float inputs:roughness = 0.6200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/water_clear.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                token outputs:rgb
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.87451, 0.96863, 0.92157)
                float inputs:roughness = 0.5400
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                token outputs:surface
            }
        }
        def Material "Metal" {
            token outputs:surface.connect = </Asset/Looks/Metal/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48000, 0.52000, 0.55000)
                float inputs:roughness = 0.2800
                float inputs:metallic = 0.7000
                token outputs:surface
            }
        }
        def Material "Stem" {
            token outputs:surface.connect = </Asset/Looks/Stem/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12000, 0.23000, 0.08000)
                float inputs:roughness = 0.7200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
    }
}
