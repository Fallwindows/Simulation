#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Xform "RailClip" {
            double3 xformOp:translate = (0.00000, -0.00360, -0.02470)
            double3 xformOp:scale = (0.13000, 0.00900, 0.00780)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Metal>
            }
        }
        def Mesh "Bezel" (
