        ) {
            point3f[] points = [(-0.12676, -0.00900, -0.03250), (0.12676, -0.00900, -0.03250), (0.13000, -0.00576, -0.03250), (0.13000, 0.00576, -0.03250), (0.12676, 0.00900, -0.03250), (-0.12676, 0.00900, -0.03250), (-0.13000, 0.00576, -0.03250), (-0.13000, -0.00576, -0.03250), (-0.12676, -0.00900, 0.03250), (0.12676, -0.00900, 0.03250), (0.13000, -0.00576, 0.03250), (0.13000, 0.00576, 0.03250), (0.12676, 0.00900, 0.03250), (-0.12676, 0.00900, 0.03250), (-0.13000, 0.00576, 0.03250), (-0.13000, -0.00576, 0.03250)]
            int[] faceVertexCounts = [8, 8, 4, 4, 4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [7, 6, 5, 4, 3, 2, 1, 0, 8, 9, 10, 11, 12, 13, 14, 15, 0, 1, 9, 8, 1, 2, 10, 9, 2, 3, 11, 10, 3, 4, 12, 11, 4, 5, 13, 12, 5, 6, 14, 13, 6, 7, 15, 14, 7, 0, 8, 15]
            rel material:binding = </Asset/Looks/Dark>
        }
        def Xform "EInkPanel" {
            double3 xformOp:translate = (0.00000, 0.00864, 0.00000)
            double3 xformOp:scale = (0.11440, 0.00090, 0.02210)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Paper>
            }
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.10067, 0.01100, -0.01856), (0.10067, 0.01100, -0.01856), (0.10067, 0.01100, 0.01856), (-0.10067, 0.01100, 0.01856)]
            int[] faceVertexCounts = [4]
            # Winding and the authored +Y normal must agree; viewed from the
            # local front (+Y), this order faces outward and preserves upright UVs.
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, 1, 0)] (
                interpolation = "uniform"
            )
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18824, 0.21569, 0.23137)
                float inputs:roughness = 0.3400
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/price_display.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86667, 0.87843, 0.83922)
                float inputs:roughness = 0.3000
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
