#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Xform "Base" {
            double3 xformOp:translate = (0.00000, 0.00000, 0.00000)
            double3 xformOp:scale = (0.22000, 0.16000, 0.11000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Body>
            }
        }
        def Xform "SlatX0" {
            double3 xformOp:translate = (-0.16720, 0.00000, 0.00000)
            double3 xformOp:scale = (0.01760, 0.16480, 0.13750)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "SlatX1" {
            double3 xformOp:translate = (0.16720, 0.00000, 0.00000)
            double3 xformOp:scale = (0.01760, 0.16480, 0.13750)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "SlatZ0" {
            double3 xformOp:translate = (0.00000, 0.00000, -0.06160)
            double3 xformOp:scale = (0.22660, 0.01280, 0.01100)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "SlatZ1" {
            double3 xformOp:translate = (0.00000, 0.00000, 0.06160)
            double3 xformOp:scale = (0.22660, 0.01280, 0.01100)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "Fruit" {
            double3 xformOp:translate = (0, 0, 0.14520)
            double3 xformOp:scale = (0.10120, 0.07360, 0.09900)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Sphere "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double radius = 0.5
                rel material:binding = </Asset/Looks/Front>
            }
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.43137, 0.53725, 0.26667)
                float inputs:roughness = 0.6200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/produce_crate_green.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                token outputs:rgb
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.87451, 0.68627, 0.25882)
                float inputs:roughness = 0.5400
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                token outputs:surface
            }
        }
        def Material "Metal" {
            token outputs:surface.connect = </Asset/Looks/Metal/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48000, 0.52000, 0.55000)
                float inputs:roughness = 0.2800
                float inputs:metallic = 0.7000
                token outputs:surface
            }
        }
        def Material "Stem" {
            token outputs:surface.connect = </Asset/Looks/Stem/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12000, 0.23000, 0.08000)
                float inputs:roughness = 0.7200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
    }
}
