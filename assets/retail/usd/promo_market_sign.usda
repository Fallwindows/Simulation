#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Mesh "BodyShell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.45625, -0.02500, -0.24000), (0.45625, -0.02500, -0.24000), (0.46000, -0.02125, -0.24000), (0.46000, 0.02125, -0.24000), (0.45625, 0.02500, -0.24000), (-0.45625, 0.02500, -0.24000), (-0.46000, 0.02125, -0.24000), (-0.46000, -0.02125, -0.24000), (-0.45625, -0.02500, 0.24000), (0.45625, -0.02500, 0.24000), (0.46000, -0.02125, 0.24000), (0.46000, 0.02125, 0.24000), (0.45625, 0.02500, 0.24000), (-0.45625, 0.02500, 0.24000), (-0.46000, 0.02125, 0.24000), (-0.46000, -0.02125, 0.24000)]
            int[] faceVertexCounts = [8, 8, 4, 4, 4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [7, 6, 5, 4, 3, 2, 1, 0, 8, 9, 10, 11, 12, 13, 14, 15, 0, 1, 9, 8, 1, 2, 10, 9, 2, 3, 11, 10, 3, 4, 12, 11, 4, 5, 13, 12, 5, 6, 14, 13, 6, 7, 15, 14, 7, 0, 8, 15]
            rel material:binding = </Asset/Looks/Body>
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.40480, 0.02700, -0.20160), (0.40480, 0.02700, -0.20160), (0.40480, 0.02700, 0.20160), (-0.40480, 0.02700, 0.20160)]
            int[] faceVertexCounts = [4]
            # Winding and the authored +Y normal must agree; viewed from the
            # local front (+Y), this order faces outward and preserves upright UVs.
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, 1, 0)] (
                interpolation = "uniform"
            )
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
        def Xform "TopBand" {
            double3 xformOp:translate = (0.00000, 0.03300, 0.16320)
            double3 xformOp:scale = (0.39560, 0.00600, 0.02400)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "BottomTrim" {
            double3 xformOp:translate = (0.00000, 0.03400, -0.19200)
            double3 xformOp:scale = (0.37720, 0.00500, 0.00600)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Metal>
            }
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.19216, 0.41176, 0.60000)
                float inputs:roughness = 0.6200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/promo_market_sign.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95294, 0.73333, 0.24314)
                float inputs:roughness = 0.5400
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                token outputs:surface
            }
        }
        def Material "Metal" {
            token outputs:surface.connect = </Asset/Looks/Metal/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48000, 0.52000, 0.55000)
                float inputs:roughness = 0.2800
                float inputs:metallic = 0.7000
                token outputs:surface
            }
        }
        def Material "Stem" {
            token outputs:surface.connect = </Asset/Looks/Stem/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12000, 0.23000, 0.08000)
                float inputs:roughness = 0.7200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
    }
}
