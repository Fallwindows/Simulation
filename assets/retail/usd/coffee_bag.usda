                rel material:binding = </Asset/Looks/Accent>
            }
        }
        def Cylinder "DegassingValve" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            uniform token axis = "Y"
            int vertices = 24
            double radius = 0.01080
            double height = 0.00480
            double3 xformOp:translate = (0.02970, 0.04000, 0.04230)
