        ) {
            point3f[] points = [(0.20370, -0.18000, -0.12000), (0.22870, -0.18000, -0.12000), (0.20370, -0.18000, 0.12000), (0.20370, 0.18000, -0.12000), (0.22870, 0.18000, -0.12000), (0.20370, 0.18000, 0.12000)]
            int[] faceVertexCounts = [3, 3, 4, 4, 4]
