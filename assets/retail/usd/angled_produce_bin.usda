            point3f[] points = [(-0.23000, -0.18000, -0.11760), (0.23000, -0.18000, -0.11760), (-0.23000, -0.18000, -0.05520), (-0.23000, 0.18000, -0.11760), (0.23000, 0.18000, -0.11760), (-0.23000, 0.18000, -0.05520)]
