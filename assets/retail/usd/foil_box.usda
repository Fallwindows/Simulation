        def Xform "HingedFlap" {
            double3 xformOp:translate = (0.00000, 0.02640, 0.00440)
            double3 xformOp:scale = (0.13640, 0.00220, 0.01980)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
