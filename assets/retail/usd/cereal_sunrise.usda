#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Mesh "BodyShell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.05750, -0.05000, -0.15500), (0.05750, -0.05000, -0.15500), (0.06500, -0.04250, -0.15500), (0.06500, 0.04250, -0.15500), (0.05750, 0.05000, -0.15500), (-0.05750, 0.05000, -0.15500), (-0.06500, 0.04250, -0.15500), (-0.06500, -0.04250, -0.15500), (-0.05750, -0.05000, 0.15500), (0.05750, -0.05000, 0.15500), (0.06500, -0.04250, 0.15500), (0.06500, 0.04250, 0.15500), (0.05750, 0.05000, 0.15500), (-0.05750, 0.05000, 0.15500), (-0.06500, 0.04250, 0.15500), (-0.06500, -0.04250, 0.15500)]
            int[] faceVertexCounts = [8, 8, 4, 4, 4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [7, 6, 5, 4, 3, 2, 1, 0, 8, 9, 10, 11, 12, 13, 14, 15, 0, 1, 9, 8, 1, 2, 10, 9, 2, 3, 11, 10, 3, 4, 12, 11, 4, 5, 13, 12, 5, 6, 14, 13, 6, 7, 15, 14, 7, 0, 8, 15]
            rel material:binding = </Asset/Looks/Body>
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.05720, 0.05200, -0.13020), (0.05720, 0.05200, -0.13020), (0.05720, 0.05200, 0.13020), (-0.05720, 0.05200, 0.13020)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(0, 1, 0)]
            uniform token[] normals:interpolation = ["uniform"]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
        def Xform "TopBand" {
            double3 xformOp:translate = (0.00000, 0.05800, 0.10540)
            double3 xformOp:scale = (0.05590, 0.00600, 0.01550)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Front>
            }
        }
        def Xform "BottomTrim" {
            double3 xformOp:translate = (0.00000, 0.05900, -0.12400)
            double3 xformOp:scale = (0.05330, 0.00500, 0.00387)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Metal>
            }
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94902, 0.65882, 0.18039)
                float inputs:roughness = 0.6200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/cereal_sunrise.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                token outputs:rgb
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15294, 0.36863, 0.60784)
                float inputs:roughness = 0.5400
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                token outputs:surface
            }
        }
        def Material "Metal" {
            token outputs:surface.connect = </Asset/Looks/Metal/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48000, 0.52000, 0.55000)
                float inputs:roughness = 0.2800
                float inputs:metallic = 0.7000
                token outputs:surface
            }
        }
        def Material "Stem" {
            token outputs:surface.connect = </Asset/Looks/Stem/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12000, 0.23000, 0.08000)
                float inputs:roughness = 0.7200
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
    }
}
