#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (
    kind = "component"
) {
    def Xform "Geometry" {
        def Cylinder "CanBody" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.06240
            double height = 0.19000
            rel material:binding = </Asset/Looks/Body>
        }
        def Cylinder "TopRim" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.06500
            double height = 0.01520
            double3 xformOp:translate = (0, 0, 0.08740)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Metal>
        }
        def Cylinder "BottomRim" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.06500
            double height = 0.01140
            double3 xformOp:translate = (0, 0, -0.08930)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Metal>
        }
        def Cylinder "Overcap" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int vertices = 48
            double radius = 0.06630
            double height = 0.02280
            double3 xformOp:translate = (0, 0, 0.08360)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </Asset/Looks/Accent>
        }
        def Xform "GripBand" {
            double3 xformOp:translate = (0.00000, 0.06240, 0.06840)
            double3 xformOp:scale = (0.06110, 0.00520, 0.00760)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            def Cube "Shape" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            ) {
                double size = 2.0
                rel material:binding = </Asset/Looks/Dark>
            }
        }
        def Mesh "FrontPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.05034, 0.06700, -0.05267), (0.05034, 0.06700, -0.05267), (0.05034, 0.06700, 0.05267), (-0.05034, 0.06700, 0.05267)]
            int[] faceVertexCounts = [4]
            # Winding and the authored +Y normal must agree; viewed from the
            # local front (+Y), this order faces outward and preserves upright UVs.
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, 1, 0)] (
                interpolation = "uniform"
            )
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Asset/Looks/Front>
        }
        def Mesh "LeftPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.06600, -0.04680, -0.05130), (-0.06600, 0.04680, -0.05130), (-0.06600, 0.04680, 0.05130), (-0.06600, -0.04680, 0.05130)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(-1, 0, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.05, 0.12), (0.34, 0.12), (0.34, 0.88), (0.05, 0.88)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Print>
        }
        def Mesh "RightPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(0.06600, 0.04680, -0.05130), (0.06600, -0.04680, -0.05130), (0.06600, -0.04680, 0.05130), (0.06600, 0.04680, 0.05130)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            normal3f[] normals = [(1, 0, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.05, 0.12), (0.34, 0.12), (0.34, 0.88), (0.05, 0.88)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Print>
        }
        def Mesh "BackPrintPanel" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            point3f[] points = [(-0.04940, -0.06600, -0.07220), (0.04940, -0.06600, -0.07220), (0.04940, -0.06600, -0.04180), (-0.04940, -0.06600, -0.04180)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 3, 2, 1]
            normal3f[] normals = [(0, -1, 0)] (interpolation = "uniform")
            texCoord2f[] primvars:st = [(0.08, 0.08), (0.92, 0.08), (0.92, 0.34), (0.08, 0.34)] (interpolation = "vertex")
            rel material:binding = </Asset/Looks/Print>
        }
    }
    def Scope "Looks" {
        def Material "Body" {
            token outputs:surface.connect = </Asset/Looks/Body/Preview.outputs:surface>
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.41176, 0.21961, 0.15294)
                float inputs:roughness = 0.3600
                float inputs:metallic = 0.0000
                token outputs:surface
            }
        }
        def Material "Front" {
            token outputs:surface.connect = </Asset/Looks/Front/Preview.outputs:surface>
            def Shader "StReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/coffee_canister.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "NormalTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/coffee_canister_normal.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "RoughnessTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/coffee_canister_roughness.png@
                float2 inputs:st.connect = </Asset/Looks/Front/StReader.outputs:result>
                float outputs:r
            }
            def Shader "Preview" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88235, 0.68235, 0.24314)
                float inputs:roughness = 0.4800
                float inputs:metallic = 0.0000
                color3f inputs:diffuseColor.connect = </Asset/Looks/Front/Texture.outputs:rgb>
                normal3f inputs:normal.connect = </Asset/Looks/Front/NormalTexture.outputs:rgb>
                float inputs:roughness.connect = </Asset/Looks/Front/RoughnessTexture.outputs:r>
                token outputs:surface
            }
        }
        def Material "Metal" {
