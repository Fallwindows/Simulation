    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </ShoppingCart/Looks/Steel/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.310000, 0.330000, 0.350000)
                float inputs:metallic = 0.880000
                float inputs:roughness = 0.240000
                float inputs:clearcoat = 0.080000
                float inputs:clearcoatRoughness = 0.180000
                token outputs:surface
            }
        }

        def Material "ZincWire"
        {
            token outputs:surface.connect = </ShoppingCart/Looks/ZincWire/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.480000, 0.510000, 0.540000)
                float inputs:metallic = 0.820000
                float inputs:roughness = 0.290000
                float inputs:clearcoat = 0.080000
                float inputs:clearcoatRoughness = 0.180000
                token outputs:surface
            }
        }

        def Material "HandlePolymer"
        {
            token outputs:surface.connect = </ShoppingCart/Looks/HandlePolymer/PreviewSurface.outputs:surface>
