            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025000, 0.105000, 0.210000)
                float inputs:metallic = 0.000000
                float inputs:roughness = 0.330000
                float inputs:clearcoat = 0.080000
                float inputs:clearcoatRoughness = 0.180000
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </ShoppingCart/Looks/Rubber/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
